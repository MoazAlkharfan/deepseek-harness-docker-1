# DeepSeek Harness environment variables
# Copy this to .env and fill in your API keys
# ============================================

# Required: DeepSeek API key
DEEPSEEK_API_KEY=sk-your-key-here

# Optional: TeamoRouter API key
# TEAMOROUTER_API_KEY=your-key-here

# Ports
# DSH_PORT   — DSH internal listen on 127.0.0.1 (default: 3079)
# PROXY_PORT — Caddy proxy external port, LAN entry (default: 3080)
DSH_PORT=3079
PROXY_PORT=3080

# Optional: Basic Auth (unset both to disable)
# PROXY_USERNAME=admin
# PROXY_PASSWORD=changeme

# Optional: auto-update DSH to latest on container start
DSH_UPDATE_ON_START=false

# Telemetry mode (ENABLED or DISABLED)
DSH_TELEMETRY_MODE=DISABLED