# DeepSeek Harness Docker — 环境变量
# 复制为 .env 后按需修改
# API 密钥请在 Web UI 中配置，无需在此设置

# Ports
DSH_PORT=3079
PROXY_PORT=3080

# Basic Auth（可选，不设置则无认证）
# PROXY_USERNAME=admin
# PROXY_PASSWORD=changeme

# 通过局域网访问时通常无需设置（Caddy 已自动放开敏感 API）
# 仅当绕过 Caddy 直连 DSH 时才需要声明访问 IP（逗号或空格分隔，不带端口）
# DSH_TRUSTED_HOSTS=192.168.0.105

# 启动时自动更新 DSH 到最新版
DSH_UPDATE_ON_START=false

# 遥测
DSH_TELEMETRY_MODE=DISABLED